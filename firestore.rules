rules_version = '2';

// ═══════════════════════════════════════════════════════════
//  Reglas de Firestore — Academia de Danzas Lazos Tricolor
//  Se pegan en: Firebase → Firestore Database → Reglas → Publicar
//
//  Regla general: TODO cerrado, salvo lo que se abre abajo.
//  El panel (index.html y panel-sudaderas.html) entra con la
//  cuenta de Google de la academia y puede hacer todo.
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'academialazostricolor@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Por defecto: solo la administración
    match /{document=**} {
      allow read, write: if esAdmin();
    }

    // ── Preinscripciones: el formulario público solo puede CREAR ──
    match /inscripciones/{id} {
      allow create: if true;
    }

    // ── Encuesta (encuesta.html) ──
    // Respuestas: el público solo crea (nunca con correo); leerlas es de la administración.
    match /respuestas/{id} {
      allow create: if !('email' in request.resource.data)
                    && request.resource.data.keys().hasAll(['timestamp', 'respondentType', 'answers']);
    }
    // Participantes: id = huella del correo. Se puede consultar UNO por su id
    // (control de duplicados) y crearlo una vez; nunca listar ni modificar.
    match /participantes/{huella} {
      allow get: if true;
      allow create: if true;
    }

    // ── Agenda: cualquiera con el link ve UN documento; nadie lista.
    //    Editan solo estas dos cuentas. (Igual que en las reglas anteriores.)
    match /agenda/{docId} {
      allow get:  if true;
      allow list: if false;
      allow write: if request.auth != null
                   && request.auth.token.email in ['alfredomariara@gmail.com', 'academialazostricolor@gmail.com'];
    }

    // ═══════════ Coreografías (coreografias.html) ═══════════
    // Coreógrafos: crean y modifican todo. Alumnas: solo leen las coreografías
    // de sus categorías, si están en /autorizados (por correo de Google o celular).
    function esCoreografo() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['academialazostricolor@gmail.com', 'alfredomariara@gmail.com'];
    }
    function claveAlumna() {
      return request.auth.token.get('phone_number', null) != null
        ? 'tel:' + request.auth.token.phone_number
        : 'mail:' + request.auth.token.get('email', '').lower();
    }
    function rutaAlumna() {
      return /databases/$(database)/documents/autorizados/$(claveAlumna());
    }
    function esAlumna() {
      return request.auth != null
        && (request.auth.token.get('phone_number', null) != null || request.auth.token.get('email_verified', false) == true)
        && exists(rutaAlumna());
    }

    match /coreografias/{id} {
      allow read: if esCoreografo()
        || (esAlumna() && resource.data.categoria in get(rutaAlumna()).data.categorias);
      allow write: if esCoreografo();
    }
    match /autorizados/{clave} {
      allow get: if request.auth != null && clave == claveAlumna();
      allow read, write: if esCoreografo();
    }
    // Solicitudes de cambio de nombre: la alumna crea la suya (nunca en una coreografía sellada)
    match /solicitudes/{id} {
      allow create: if esAlumna()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.clave == claveAlumna()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.nombreNuevo is string
        && request.resource.data.nombreNuevo.size() <= 30
        && get(/databases/$(database)/documents/coreografias/$(request.resource.data.coreoId)).data.get('sellada', false) != true;
      allow read: if esCoreografo() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if esCoreografo();
    }

    // ── Sudaderas: página del papá (sudaderas.html?id=...) ──
    // Puede abrir SU registro por el id del enlace (no listar todos),
    // elegir talla si aún no tiene, y agregar / anular abonos.
    // No puede editar abonos existentes (así no se auto-aprueba uno ya enviado).
    match /sudaderas/{id} {
      allow get: if true;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['talla', 'total', 'abonos', 'actualizadoEn'])
        // talla y total solo cambian si todavía no había talla
        && (resource.data.talla == null
            || (request.resource.data.talla == resource.data.talla
                && request.resource.data.total == resource.data.total))
        // abonos: se pueden agregar o quitar, nunca modificar uno existente
        && request.resource.data.abonos.diff(resource.data.abonos).changedKeys().size() == 0;
    }
  }
}
